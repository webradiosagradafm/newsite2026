/**
 * Adiciona parâmetros de otimização de imagem nas URLs do Cloudinary.
 * 
 * @param url URL original do Cloudinary
 * @param width Largura desejada em pixels (ex: 64, 162, 300)
 * @param height Altura desejada em pixels
 * @returns URL otimizada com compressão e formato automáticos
 */
export function getOptimizedImageUrl(
  url: string,
  width: number,
  height?: number
): string {
  if (!url || !url.includes('res.cloudinary.com')) return url;

  const hParam = height ? `,h_${height}` : '';
  // c_fill ajusta o corte, q_auto comprime sem perda, f_auto entrega WebP/AVIF
  const transformations = `w_${width}${hParam},c_fill,q_auto,f_auto`;

  return url.replace('/upload/', `/upload/${transformations}/`);
}